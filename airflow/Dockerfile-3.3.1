FROM apache/airflow:3.3.1

ENV DEBIAN_FRONTEND=noninteractive

# Official airflow runs as UID 50000; apt needs root, then restore airflow.
USER root
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER airflow
