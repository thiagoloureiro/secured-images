FROM apache/airflow:3.3.1

ENV DEBIAN_FRONTEND=noninteractive

# Official airflow runs as UID 50000; apt needs root, then restore airflow.
USER root
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER airflow

# Official image ships litellm 1.85.7; scanners flag CVEs fixed in 1.103.1.
RUN python -m pip install --no-cache-dir --upgrade "litellm==1.103.1"
