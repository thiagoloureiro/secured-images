FROM apache/airflow:3.3.2

ENV DEBIAN_FRONTEND=noninteractive

# Official airflow runs as UID 50000; apt needs root, then restore airflow.
USER root
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER airflow

# Official image ships litellm 1.85.7, urllib3 2.7.0, virtualenv 21.7.9,
# and tornado 6.5.8; scanners flag CVEs fixed in these pins.
RUN python -m pip install --no-cache-dir --upgrade \
        "litellm==1.103.1" \
        "urllib3>=2.8.0" \
        "virtualenv>=21.14.2" \
        "tornado>=6.5.10"
RUN python -m pip uninstall --yes pip && rm -rf /root/.cache/pip