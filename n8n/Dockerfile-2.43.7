FROM alpine:3.24 AS apk
RUN apk add --no-cache apk-tools-static

FROM n8nio/n8n:2.43.7

# Official image runs as node and deletes apk-tools. DHI hash-pins packages,
# which blocks Alpine updates for openssl, curl, and other libs. The dhi.io
# repo certificate is not trusted in this image, so upgrade from Alpine 3.24.
USER root
COPY --from=apk /sbin/apk.static /sbin/apk.static
RUN set -eux; \
    grep -v 'dhi.io' /etc/apk/repositories > /tmp/repositories; \
    mv /tmp/repositories /etc/apk/repositories; \
    sed -i 's/><Q1[^=]*=//' /etc/apk/world; \
    ln -sf apk.static /sbin/apk; \
    apk update; \
    apk upgrade; \
    rm -f /sbin/apk /sbin/apk.static; \
    rm -rf /var/cache/apk/* /tmp/*
# simple-git 4.0.1 blocks trailer.<key>.cmd. argv-parser 2.0.1 treats VISUAL as an
# unsafe editor. simple-git 4 also rejects GIT_* env values unless they are named
# in allowEnvironment, so the Git node and source-control callers list the
# variables they already set. The CJS build is given a default export because the
# Git node loads simple-git through TypeScript's __importDefault helper.
COPY patch-npm.mjs /tmp/patch-npm.mjs
RUN set -eux; \
    mkdir -p /tmp/npm-patches; \
    npm pack --pack-destination /tmp/npm-patches \
      simple-git@4.0.1 \
      @simple-git/argv-parser@2.0.1 \
      @simple-git/args-pathspec@1.0.4 \
      handlebars@4.7.10; \
    node /tmp/patch-npm.mjs; \
    rm -rf /tmp/npm-patches /tmp/patch-npm.mjs /root/.npm
USER node
