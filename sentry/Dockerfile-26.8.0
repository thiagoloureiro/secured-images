FROM ghcr.io/getsentry/sentry:26.8.0

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Patch known-vulnerable Python deps pulled in by the base image beyond Sentry's own pins
RUN pip install --no-cache-dir --upgrade \
    "anyio>=4.14.2" \
    "mistune>=3.3.3" \
    "setuptools>=78.1.1" \
    "sqlparse>=0.6.0" \
    "Django>=5.2.16,<6.0" \
    "djangorestframework>=3.17.2"

RUN pip install --upgrade pip
RUN pip install --upgrade anyio
RUN pip install --upgrade msgpack
